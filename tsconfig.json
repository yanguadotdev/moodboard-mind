{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@spb/*": ["./src/lib/supabase/*"],
      "@utils": ["./src/lib/utils"],
      "@modules/*": ["./src/modules/*"],
      "@helpers": ["./src/lib/helpers"],
      "@ui/*": ["./src/components/ui/*"],
      "@auth/*": ["./src/modules/auth/*"],
      "@vault/*": ["./src/modules/vault/*"],
      "@spaces/*": ["./src/modules/spaces/*"],
      "@typings/*": ["./src/types/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
